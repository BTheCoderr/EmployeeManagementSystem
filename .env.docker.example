# Production-style Docker environment example.
# Copy values into your own environment or Docker secret management.
NODE_ENV=production
PORT=3000
DATABASE_PATH=/app/data/peopleops.sqlite
SESSION_SECRET=replace-with-a-long-random-secret
DEMO_ADMIN_PASSWORD=replace-with-a-strong-admin-password
DEMO_MANAGER_PASSWORD=replace-with-a-strong-manager-password
DEMO_VIEWER_PASSWORD=replace-with-a-strong-viewer-password
